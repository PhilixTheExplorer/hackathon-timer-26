# ─────────────────────────────────────────────────────────────────────────
# SIT Hackathon Timer — configuration
# Copy this file to ".env" and edit. All vars must be prefixed VITE_ to be
# exposed to the client by Vite.
# ─────────────────────────────────────────────────────────────────────────

# Event identity
VITE_EVENT_TITLE="SIT HACKATHON"
VITE_EVENT_YEAR="2026"
VITE_EVENT_ORG="School of Information Technology · KMUTT"

# Timezone the countdown is reckoned in (IANA name). Bangkok = Asia/Bangkok (UTC+7).
VITE_TIMEZONE="Asia/Bangkok"

# Start / end of the event.
#  • You MAY include an explicit offset:  2026-05-31T17:00:00+07:00
#  • OR omit it (2026-05-31T17:00:00) and it is interpreted in VITE_TIMEZONE.
# The timer counts DOWN to VITE_END_TIME.
VITE_START_TIME="2026-05-29T09:00:00"
VITE_END_TIME="2026-05-31T17:00:00"

# Phase thresholds (minutes of remaining time)
VITE_URGENT_MIN="60"   # <= this  → URGENT  (amber)
VITE_ALARM_MIN="5"     # <= this  → ALARM   (red, pulsing)

# Default visual direction: terminal | reactor | signal
VITE_THEME="signal"

# Optional toggles
VITE_SHOW_DAYS="true"
VITE_SHOW_MILESTONES="true"
VITE_SCANLINES="true"

# Milestones — JSON array of { "label": "...", "time": "ISO (offset optional)" }.
# Times follow the same rule as START/END above.
VITE_MILESTONES='[
  { "label": "KICKOFF",    "time": "2026-05-29T09:00:00" },
  { "label": "MENTORING",  "time": "2026-05-29T19:00:00" },
  { "label": "CHECKPOINT", "time": "2026-05-30T13:00:00" },
  { "label": "SUBMISSION", "time": "2026-05-31T12:00:00" },
  { "label": "JUDGING",    "time": "2026-05-31T17:00:00" }
]'
